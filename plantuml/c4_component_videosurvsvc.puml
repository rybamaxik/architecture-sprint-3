@startuml
title Диаграмма компонентов сервиса управления устройствами видеонаблюдения

top to bottom direction

!includeurl https://raw.githubusercontent.com/RicardoNiepel/C4-PlantUML/master/C4_Component.puml

Container_Boundary(WarmhouseSystem, "Система 'Тёплый дом'") {
  Container(VideoSurveillanceService, "Микросервис управления устройствами видеонаблюдения", "Java, Spring Boot", "Обеспечивает управление устройствами видеонаблюдения и получение телеметрии и видеопотока от них")
  Container(APIGateway, "Шлюз API", "Kong", "Маршрутизация API на сервисы")
  ContainerQueue(VideoSurveillanceQueue, "Очередь с топиками для устройств видеонаблюдения", "Kafka", "Сюда помещаются данные о состоянии устройств видеонаблюдения, телеметрия")
  Container_Ext(SmartHomeGate, "Шлюз умного дома", "Управляет и обеспечивает обмен данными со всеми умными устройствами этого дома")
  Component_Ext(VideoSurveillanceDevice, "Устройство видеонаблюдения", "Обеспечивает съемку и передачу видеопотока")
}

Container(VideoSurveillanceService, "Микросервис управления устройствами видеонаблюдения", "Java, Spring Boot", "Обеспечивает управление устройствами видеонаблюдения и получение телеметрии и видеопотока") {
  Component(ServiceLayer, "Бизнес-логика сервиса", "Бизнес-логика работы с устройствами видеонаблюдения")
  Component(RepositoryLayer, "Репозиторий хранения данных", "Логика работы с БД")
  Component(VideoStreamBroadcaster, "Трансляция видеопотока", "Компонент получения видеопотока от камер и раздачи их клиентам")
  Component(DeviceInteropLayer, "Работа с устройствами", "Поддержка протоколов, специфическая для устройств логика запроса состояния, показания датчиков, телеметрии, подача команд на управление видеопотоком")
  ComponentDb(VideoSurveillanceDB, "База данных сервиса устройств видеонаблюдения", "PostgreSQL", "Хранит данные о запросах на управление, текущем состоянии и телеметрии")
}

Rel(APIGateway, ServiceLayer, "Запрос состояния устройств и видеопотока, команды на управление")
Rel(ServiceLayer, APIGateway, "Состояние устройств, показатели датчиков, квитанции о выполнении команд, уведомления")
Rel(VideoStreamBroadcaster, APIGateway, "Видеопоток")
Rel(VideoSurveillanceDevice, VideoStreamBroadcaster, "Видеопоток")
Rel(SmartHomeGate, VideoSurveillanceDevice, "Команды на управление видеокамерой, запросы состояния")

Rel(ServiceLayer, RepositoryLayer, "Текущее состояние устройств, текущие показатели датчиков")
Rel(RepositoryLayer, ServiceLayer, "Последние сохранённые состояния устройств, показатели датчиков")
Rel(RepositoryLayer, VideoSurveillanceDB, "Обмен данными с СУБД")

Rel(ServiceLayer, VideoSurveillanceQueue, "Состояние устройств, показатели датчиков, полученные команды на управление")
Rel(VideoSurveillanceQueue, ServiceLayer, "Последние (еще не выполненные) команды на управление")

Rel(ServiceLayer, DeviceInteropLayer, "Запросы текущего состояния и показаталей, команды на управление")
Rel(DeviceInteropLayer, ServiceLayer, "Состояние устройств, показатели датчиков, телеметрия")

Rel(DeviceInteropLayer, SmartHomeGate, "Запросы состояния устройств, показаний датчиков, телеметрии, команды на управление")
Rel(SmartHomeGate, DeviceInteropLayer, "Текущее состояние устройств, показания датчиков, телеметрия")

@enduml
